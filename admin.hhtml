<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kribi Paradise - Admin Panel</title>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-color: #0A0A0A;
            --secondary-color: #FFFFFF;
            --accent-color: #D4AF37;
            --accent-light: #F4E4B5;
            --accent-dark: #B8941F;
            --dark-bg: #111111;
            --card-bg: #1A1A1A;
            --success-color: #27ae60;
            --danger-color: #e74c3c;
            --warning-color: #f39c12;
            --info-color: #3498db;
            --shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            --shadow-light: 0 4px 12px rgba(0, 0, 0, 0.1);
            --border-radius: 12px;
            --transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: #0A0A0A;
            color: #FFFFFF;
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
        }

        /* Gold Gradient Text */
        .gold-gradient {
            background: linear-gradient(135deg, #D4AF37 0%, #F4E4B5 50%, #B8941F 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .container {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar Navigation */
        .sidebar {
            width: 280px;
            background: linear-gradient(180deg, #111111 0%, #0A0A0A 100%);
            color: white;
            padding: 0;
            transition: var(--transition);
            position: fixed;
            height: 100vh;
            z-index: 1000;
            overflow-y: auto;
            border-right: 1px solid rgba(212, 175, 55, 0.1);
        }

        .sidebar.collapsed {
            width: 80px;
        }

        .sidebar-header {
            padding: 25px 20px;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(10, 10, 10, 0.9);
        }

        .sidebar-header .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sidebar-header .logo-img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            overflow: hidden;
            background: #0A0A0A;
            border: 2px solid rgba(212, 175, 55, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar-header .logo-img img {
            width: 80%;
            height: 80%;
            object-fit: contain;
        }

        .sidebar-header h2 {
            font-size: 1.4rem;
            font-weight: 800;
            white-space: nowrap;
        }

        .toggle-btn {
            background: rgba(212, 175, 55, 0.1);
            border: none;
            color: #D4AF37;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .toggle-btn:hover {
            background: rgba(212, 175, 55, 0.2);
            transform: rotate(90deg);
        }

        .sidebar-menu {
            list-style: none;
            padding: 20px 0;
        }

        .sidebar-menu li {
            padding: 0;
        }

        .sidebar-menu a {
            display: flex;
            align-items: center;
            padding: 16px 24px;
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            transition: var(--transition);
            white-space: nowrap;
            position: relative;
            border-left: 3px solid transparent;
        }

        .sidebar-menu a:hover {
            background: rgba(212, 175, 55, 0.05);
            color: #F4E4B5;
            border-left-color: rgba(212, 175, 55, 0.3);
        }

        .sidebar-menu a.active {
            background: linear-gradient(90deg, rgba(212, 175, 55, 0.15) 0%, rgba(212, 175, 55, 0.05) 100%);
            color: #D4AF37;
            border-left-color: #D4AF37;
        }

        .sidebar-menu a i {
            font-size: 1.2rem;
            margin-right: 16px;
            width: 24px;
            text-align: center;
            color: #D4AF37;
        }

        .sidebar-menu a .badge {
            position: absolute;
            right: 20px;
            background: #D4AF37;
            color: #0A0A0A;
            font-size: 0.7rem;
            font-weight: bold;
            padding: 2px 6px;
            border-radius: 10px;
            min-width: 20px;
            text-align: center;
        }

        .sidebar.collapsed .sidebar-menu a span,
        .sidebar.collapsed .sidebar-header .logo span,
        .sidebar.collapsed .badge {
            display: none;
        }

        .sidebar.collapsed .sidebar-menu a i {
            margin-right: 0;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            margin-left: 280px;
            transition: var(--transition);
            background: #0A0A0A;
        }

        .main-content.expanded {
            margin-left: 80px;
        }

        /* Top Bar */
        .top-bar {
            background: rgba(10, 10, 10, 0.95);
            padding: 20px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
            position: sticky;
            top: 0;
            z-index: 100;
            backdrop-filter: blur(10px);
        }

        .top-bar h1 {
            font-size: 1.8rem;
            color: #FFFFFF;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .user-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, #D4AF37 0%, #F4E4B5 50%, #B8941F 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0A0A0A;
            font-weight: bold;
            font-size: 1.1rem;
            border: 2px solid rgba(212, 175, 55, 0.3);
        }

        .top-bar-actions {
            display: flex;
            gap: 10px;
        }

        .top-bar-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(212, 175, 55, 0.2);
            color: rgba(255, 255, 255, 0.8);
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .top-bar-btn:hover {
            background: rgba(212, 175, 55, 0.1);
            color: #D4AF37;
            transform: translateY(-2px);
        }

        /* Content Area */
        .content {
            padding: 30px;
        }

        /* Dashboard Stats */
        .stats-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 24px;
            margin-bottom: 40px;
        }

        .stat-card {
            background: linear-gradient(145deg, #1A1A1A 0%, #111111 100%);
            border-radius: var(--border-radius);
            padding: 24px;
            box-shadow: var(--shadow-light);
            display: flex;
            align-items: center;
            gap: 20px;
            border: 1px solid rgba(212, 175, 55, 0.1);
            transition: var(--transition);
        }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: rgba(212, 175, 55, 0.3);
            box-shadow: var(--shadow);
        }

        .stat-icon {
            width: 70px;
            height: 70px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            background: rgba(212, 175, 55, 0.1);
            color: #D4AF37;
        }

        .stat-info h3 {
            font-size: 2rem;
            margin-bottom: 5px;
            color: #FFFFFF;
        }

        .stat-info p {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.9rem;
        }

        /* Gallery Grid */
        .gallery-section {
            background: linear-gradient(145deg, #1A1A1A 0%, #111111 100%);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-light);
            padding: 30px;
            margin-bottom: 40px;
            border: 1px solid rgba(212, 175, 55, 0.1);
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .section-header h2 {
            color: #FFFFFF;
            font-size: 1.6rem;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition);
            font-family: 'Inter', sans-serif;
        }

        .btn-primary {
            background: linear-gradient(135deg, #D4AF37 0%, #B8941F 100%);
            color: #0A0A0A;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #F4E4B5 0%, #D4AF37 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
        }

        .btn-success {
            background: linear-gradient(135deg, #27ae60 0%, #219653 100%);
            color: white;
        }

        .btn-danger {
            background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
            color: white;
        }

        .btn-warning {
            background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
            color: white;
        }

        .btn-outline {
            background: transparent;
            border: 2px solid #D4AF37;
            color: #D4AF37;
        }

        .btn-outline:hover {
            background: rgba(212, 175, 55, 0.1);
        }

        .btn-sm {
            padding: 8px 16px;
            font-size: 0.85rem;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
        }

        .photo-card {
            background: rgba(255, 255, 255, 0.03);
            border-radius: var(--border-radius);
            overflow: hidden;
            box-shadow: var(--shadow-light);
            transition: var(--transition);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .photo-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow);
            border-color: rgba(212, 175, 55, 0.3);
        }

        .photo-img-container {
            width: 100%;
            height: 200px;
            overflow: hidden;
            position: relative;
        }

        .photo-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .photo-card:hover .photo-img {
            transform: scale(1.05);
        }

        .photo-badge {
            position: absolute;
            top: 12px;
            right: 12px;
            background: rgba(10, 10, 10, 0.8);
            color: #D4AF37;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            backdrop-filter: blur(5px);
        }

        .photo-info {
            padding: 20px;
        }

        .photo-title {
            font-weight: 700;
            margin-bottom: 8px;
            color: #FFFFFF;
            font-size: 1.1rem;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .photo-category {
            display: inline-block;
            background: rgba(212, 175, 55, 0.1);
            color: #D4AF37;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .photo-description {
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.85rem;
            margin-bottom: 16px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.5;
        }

        .photo-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.8rem;
            color: rgba(255, 255, 255, 0.4);
        }

        .photo-actions {
            display: flex;
            gap: 8px;
            margin-top: 15px;
        }

        /* Form Styles */
        .form-container {
            background: linear-gradient(145deg, #1A1A1A 0%, #111111 100%);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-light);
            padding: 40px;
            max-width: 900px;
            margin: 0 auto;
            border: 1px solid rgba(212, 175, 55, 0.1);
        }

        .form-group {
            margin-bottom: 24px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #FFFFFF;
            font-size: 0.95rem;
        }

        .form-control {
            width: 100%;
            padding: 14px 18px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(212, 175, 55, 0.2);
            border-radius: 10px;
            font-size: 1rem;
            color: #FFFFFF;
            transition: var(--transition);
        }

        .form-control:focus {
            outline: none;
            border-color: #D4AF37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
            background: rgba(255, 255, 255, 0.08);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        textarea.form-control {
            min-height: 140px;
            resize: vertical;
            line-height: 1.5;
        }

        .file-upload {
            border: 2px dashed rgba(212, 175, 55, 0.3);
            border-radius: 12px;
            padding: 40px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
            background: rgba(212, 175, 55, 0.02);
        }

        .file-upload:hover, .file-upload.dragover {
            border-color: #D4AF37;
            background: rgba(212, 175, 55, 0.05);
        }

        .file-upload i {
            font-size: 3rem;
            color: #D4AF37;
            margin-bottom: 20px;
        }

        .file-upload p {
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 5px;
        }

        .file-upload .file-size {
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.5);
        }

        .image-preview {
            margin-top: 20px;
            border-radius: 10px;
            overflow: hidden;
            max-width: 300px;
            display: none;
        }

        .image-preview img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* Category Tags */
        .category-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }

        .category-tag {
            background: rgba(212, 175, 55, 0.1);
            color: #D4AF37;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: var(--transition);
        }

        .category-tag:hover {
            background: rgba(212, 175, 55, 0.2);
        }

        .category-tag.active {
            background: #D4AF37;
            color: #0A0A0A;
        }

        /* Modal */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(10, 10, 10, 0.9);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(5px);
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: linear-gradient(145deg, #1A1A1A 0%, #111111 100%);
            border-radius: var(--border-radius);
            width: 90%;
            max-width: 800px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(212, 175, 55, 0.2);
            animation: slideUp 0.4s ease;
        }

        @keyframes slideUp {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .modal-header {
            padding: 25px 30px;
            border-bottom: 1px solid rgba(212, 175, 55, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h3 {
            color: #FFFFFF;
            font-size: 1.5rem;
        }

        .close-btn {
            background: none;
            border: none;
            color: rgba(255, 255, 255, 0.6);
            font-size: 1.8rem;
            cursor: pointer;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .close-btn:hover {
            background: rgba(212, 175, 55, 0.1);
            color: #D4AF37;
        }

        .modal-body {
            padding: 30px;
        }

        /* Settings Panel */
        .settings-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .settings-card {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 12px;
            padding: 25px;
            border: 1px solid rgba(212, 175, 55, 0.1);
        }

        .settings-card h4 {
            color: #FFFFFF;
            margin-bottom: 20px;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .settings-card h4 i {
            color: #D4AF37;
        }

        .switch {
            position: relative;
            display: inline-block;
            width: 60px;
            height: 30px;
        }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(255, 255, 255, 0.1);
            transition: var(--transition);
            border-radius: 34px;
        }

        .slider:before {
            position: absolute;
            content: "";
            height: 22px;
            width: 22px;
            left: 4px;
            bottom: 4px;
            background-color: rgba(255, 255, 255, 0.8);
            transition: var(--transition);
            border-radius: 50%;
        }

        input:checked + .slider {
            background-color: #D4AF37;
        }

        input:checked + .slider:before {
            transform: translateX(30px);
            background-color: #0A0A0A;
        }

        /* Toast Notifications */
        .toast-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 9999;
        }

        .toast {
            background: linear-gradient(145deg, #1A1A1A 0%, #111111 100%);
            border-left: 4px solid #D4AF37;
            color: #FFFFFF;
            padding: 16px 24px;
            border-radius: 10px;
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: var(--shadow);
            max-width: 350px;
            transform: translateX(100%);
            opacity: 0;
            animation: slideInRight 0.3s ease forwards, fadeOut 0.3s ease 4.7s forwards;
        }

        @keyframes slideInRight {
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @keyframes fadeOut {
            to {
                opacity: 0;
                transform: translateX(100%);
            }
        }

        .toast i {
            color: #D4AF37;
            font-size: 1.2rem;
        }

        .toast-success {
            border-left-color: var(--success-color);
        }

        .toast-success i {
            color: var(--success-color);
        }

        .toast-error {
            border-left-color: var(--danger-color);
        }

        .toast-error i {
            color: var(--danger-color);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 30px;
            color: rgba(255, 255, 255, 0.5);
        }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 20px;
            color: rgba(255, 255, 255, 0.1);
        }

        .empty-state h3 {
            font-size: 1.5rem;
            margin-bottom: 10px;
            color: rgba(255, 255, 255, 0.7);
        }

        .empty-state p {
            max-width: 500px;
            margin: 0 auto 25px;
        }

        /* Categories List */
        .categories-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .category-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 10px;
            border-left: 4px solid #D4AF37;
            transition: var(--transition);
        }

        .category-item:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .category-info h4 {
            color: #FFFFFF;
            margin-bottom: 5px;
        }

        .category-info .category-count {
            font-size: 0.8rem;
            color: rgba(255, 255, 255, 0.5);
        }

        .category-actions {
            display: flex;
            gap: 8px;
        }

        /* Responsive Styles */
        @media (max-width: 1200px) {
            .form-row {
                grid-template-columns: 1fr;
            }
            
            .settings-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 80px;
            }
            
            .sidebar-header .logo span,
            .sidebar-menu a span,
            .badge {
                display: none;
            }
            
            .sidebar-menu a i {
                margin-right: 0;
            }
            
            .main-content {
                margin-left: 80px;
            }
            
            .gallery-grid {
                grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            }
            
            .stats-container {
                grid-template-columns: 1fr;
            }
            
            .content {
                padding: 20px;
            }
        }

        @media (max-width: 576px) {
            .top-bar {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
                padding: 15px;
            }
            
            .user-info {
                width: 100%;
                justify-content: space-between;
            }
            
            .gallery-grid {
                grid-template-columns: 1fr;
            }
            
            .section-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
            
            .form-container {
                padding: 25px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Sidebar Navigation -->
        <nav class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <div class="logo-img">
                        <img src="Logo-Kribi-ParadiseMODERNEo_page-0001 (1).jpg" alt="Kribi Paradise Logo">
                    </div>
                    <h2>KRIBI<span class="gold-gradient">PARADISE</span></h2>
                </div>
                <button class="toggle-btn" id="toggleSidebar">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
            <ul class="sidebar-menu">
                <li><a href="#" class="active" data-section="dashboard"><i class="fas fa-chart-line"></i><span>Tableau de Bord</span></a></li>
                <li><a href="#" data-section="gallery"><i class="fas fa-images"></i><span>Gestion Galerie</span></a></li>
                <li><a href="#" data-section="add-photo"><i class="fas fa-plus-circle"></i><span>Ajouter Photo</span></a></li>
                <li><a href="#" data-section="categories"><i class="fas fa-tags"></i><span>Catégories</span></a></li>
                <li><a href="#" data-section="preview"><i class="fas fa-eye"></i><span>Aperçu Galerie</span></a></li>
                <li><a href="#" data-section="settings"><i class="fas fa-cog"></i><span>Paramètres</span></a></li>
                <li><a href="gallery.html" target="_blank"><i class="fas fa-external-link-alt"></i><span>Voir Galerie Publique</span></a></li>
            </ul>
        </nav>

        <!-- Main Content -->
        <main class="main-content" id="mainContent">
            <!-- Top Bar -->
            <div class="top-bar">
                <h1 id="pageTitle">Tableau de Bord</h1>
                <div class="user-info">
                    <div class="top-bar-actions">
                        <button class="top-bar-btn" id="refreshBtn" title="Actualiser">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                        <button class="top-bar-btn" id="notificationsBtn" title="Notifications">
                            <i class="fas fa-bell"></i>
                        </button>
                    </div>
                    <div class="user-avatar">KP</div>
                    <span>Admin Kribi Paradise</span>
                </div>
            </div>

            <!-- Content Area -->
            <div class="content">
                <!-- Dashboard Section -->
                <section id="dashboard" class="content-section active">
                    <div class="stats-container">
                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="fas fa-images"></i>
                            </div>
                            <div class="stat-info">
                                <h3 id="totalPhotos">0</h3>
                                <p>Photos Total</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="fas fa-tags"></i>
                            </div>
                            <div class="stat-info">
                                <h3 id="totalCategories">0</h3>
                                <p>Catégories</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="fas fa-calendar-alt"></i>
                            </div>
                            <div class="stat-info">
                                <h3 id="lastUpdate">0</h3>
                                <p>Jours depuis mise à jour</p>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="stat-info">
                                <h3 id="publishedPhotos">0</h3>
                                <p>Photos Publiées</p>
                            </div>
                        </div>
                    </div>

                    <div class="gallery-section">
                        <div class="section-header">
                            <h2>Photos Récentes</h2>
                            <button class="btn btn-primary" id="viewAllBtn">
                                <i class="fas fa-images"></i> Voir Toutes
                            </button>
                        </div>
                        <div class="gallery-grid" id="recentPhotosGrid">
                            <div class="empty-state" style="grid-column: 1 / -1;">
                                <i class="fas fa-images"></i>
                                <h3>Aucune photo dans la galerie</h3>
                                <p>Commencez par ajouter votre première photo pour enrichir votre galerie</p>
                                <button class="btn btn-primary" id="addFirstPhotoBtn">
                                    <i class="fas fa-plus"></i> Ajouter une Photo
                                </button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Gallery Management Section -->
                <section id="gallery" class="content-section">
                    <div class="gallery-section">
                        <div class="section-header">
                            <h2>Gestion de la Galerie</h2>
                            <div>
                                <button class="btn btn-outline" id="filterAll">
                                    Toutes
                                </button>
                                <button class="btn btn-primary" id="addNewPhotoBtn">
                                    <i class="fas fa-plus-circle"></i> Nouvelle Photo
                                </button>
                            </div>
                        </div>
                        <div class="gallery-grid" id="galleryGrid">
                            <div class="empty-state" style="grid-column: 1 / -1;">
                                <i class="fas fa-images"></i>
                                <h3>Galerie Vide</h3>
                                <p>Votre galerie ne contient aucune photo pour le moment</p>
                                <button class="btn btn-primary" id="addFirstGalleryPhotoBtn">
                                    <i class="fas fa-plus"></i> Ajouter votre Première Photo
                                </button>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Add Photo Section -->
                <section id="add-photo" class="content-section">
                    <div class="form-container">
                        <h2 style="margin-bottom: 30px; color: #FFFFFF; text-align: center;">Ajouter une Nouvelle Photo</h2>
                        <form id="photoForm">
                            <div class="form-group">
                                <label for="photoTitle">Titre de la Photo *</label>
                                <input type="text" id="photoTitle" class="form-control" placeholder="Entrez le titre de la photo" required>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="photoCategory">Catégorie *</label>
                                    <select id="photoCategory" class="form-control" required>
                                        <option value="">Sélectionnez une catégorie</option>
                                        <!-- Categories will be dynamically populated -->
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="photoLocation">Lieu</label>
                                    <input type="text" id="photoLocation" class="form-control" placeholder="ex: Chutes de la Lobé, Kribi">
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label for="photoDescription">Description *</label>
                                <textarea id="photoDescription" class="form-control" placeholder="Entrez une description détaillée de la photo" required></textarea>
                            </div>
                            
                            <div class="form-group">
                                <label for="photoUpload">Télécharger la Photo *</label>
                                <div class="file-upload" id="photoUpload">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <p>Cliquez pour télécharger ou glissez-déposez</p>
                                    <p>PNG, JPG, JPEG jusqu'à 10MB</p>
                                    <input type="file" id="fileInput" accept="image/*" style="display: none;">
                                </div>
                                <div id="fileName" style="margin-top: 15px; color: rgba(255, 255, 255, 0.6); font-style: italic;"></div>
                                <div class="image-preview" id="imagePreview">
                                    <img id="previewImage" src="#" alt="Aperçu">
                                </div>
                            </div>
                            
                            <div class="form-row">
                                <div class="form-group">
                                    <label for="photographer">Photographe</label>
                                    <input type="text" id="photographer" class="form-control" placeholder="Nom du photographe">
                                </div>
                                <div class="form-group">
                                    <label for="photoDate">Date de la Photo</label>
                                    <input type="date" id="photoDate" class="form-control">
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label>Tags (Sélectionnez un ou plusieurs)</label>
                                <div class="category-tags" id="categoryTags">
                                    <!-- Tags will be dynamically added -->
                                </div>
                            </div>
                            
                            <div style="display: flex; gap: 15px; margin-top: 40px;">
                                <button type="submit" class="btn btn-primary" style="flex: 1;">
                                    <i class="fas fa-save"></i> Enregistrer & Publier
                                </button>
                                <button type="button" id="saveDraftBtn" class="btn btn-outline" style="flex: 1;">
                                    <i class="fas fa-file-alt"></i> Enregistrer comme Brouillon
                                </button>
                                <button type="reset" class="btn" style="flex: 1; background: rgba(255, 255, 255, 0.05); color: rgba(255, 255, 255, 0.8);">
                                    <i class="fas fa-redo"></i> Réinitialiser
                                </button>
                            </div>
                        </form>
                    </div>
                </section>

                <!-- Categories Management Section -->
                <section id="categories" class="content-section">
                    <div class="form-container">
                        <h2 style="margin-bottom: 30px; color: #FFFFFF; text-align: center;">Gestion des Catégories</h2>
                        
                        <div class="form-group">
                            <label for="newCategoryName">Nouvelle Catégorie</label>
                            <div class="form-row">
                                <div class="form-group">
                                    <input type="text" id="newCategoryName" class="form-control" placeholder="Nom de la catégorie">
                                </div>
                                <div class="form-group">
                                    <button id="addCategoryBtn" class="btn btn-primary" style="width: 100%;">
                                        <i class="fas fa-plus"></i> Ajouter Catégorie
                                    </button>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label>Catégories Existantes</label>
                            <div id="categoriesList" class="categories-list">
                                <!-- Categories will be dynamically added here -->
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Preview Gallery Section -->
                <section id="preview" class="content-section">
                    <div class="gallery-section">
                        <div class="section-header">
                            <h2>Aperçu de la Galerie Publique</h2>
                            <div>
                                <button class="btn btn-primary" id="refreshPreviewBtn">
                                    <i class="fas fa-sync-alt"></i> Actualiser l'Aperçu
                                </button>
                            </div>
                        </div>
                        <p style="margin-bottom: 25px; color: rgba(255, 255, 255, 0.6); text-align: center;">
                            Voici comment votre galerie apparaîtra aux visiteurs sur le site public.
                        </p>
                        
                        <div class="gallery-grid" id="previewGallery">
                            <div class="empty-state" style="grid-column: 1 / -1;">
                                <i class="fas fa-eye"></i>
                                <h3>Aucune photo publiée</h3>
                                <p>Les photos ajoutées apparaîtront ici une fois publiées</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Settings Section -->
                <section id="settings" class="content-section">
                    <div class="form-container">
                        <h2 style="margin-bottom: 30px; color: #FFFFFF; text-align: center;">Paramètres de la Galerie</h2>
                        
                        <div class="settings-grid">
                            <div class="settings-card">
                                <h4><i class="fas fa-palette"></i> Apparence</h4>
                                <div class="form-group">
                                    <label for="galleryTitle">Titre de la Galerie</label>
                                    <input type="text" id="galleryTitle" class="form-control" value="Galerie Kribi Paradise">
                                </div>
                                
                                <div class="form-group">
                                    <label for="galleryDescription">Description de la Galerie</label>
                                    <textarea id="galleryDescription" class="form-control" rows="3">Découvrez la beauté captivante de Kribi à travers notre collection exclusive de photos.</textarea>
                                </div>
                                
                                <div class="form-group">
                                    <label for="galleryStyle">Style de la Galerie</label>
                                    <select id="galleryStyle" class="form-control">
                                        <option value="masonry">Mosaïque (Recommandé)</option>
                                        <option value="grid">Grille</option>
                                    </select>
                                </div>
                            </div>
                            
                            <div class="settings-card">
                                <h4><i class="fas fa-sliders-h"></i> Affichage</h4>
                                
                                <div class="form-group">
                                    <label for="itemsPerPage">Photos par Page</label>
                                    <select id="itemsPerPage" class="form-control">
                                        <option value="12">12</option>
                                        <option value="24" selected>24</option>
                                        <option value="36">36</option>
                                        <option value="48">48</option>
                                    </select>
                                </div>
                                
                                <div class="form-group" style="display: flex; justify-content: space-between; align-items: center;">
                                    <span>Afficher les descriptions</span>
                                    <label class="switch">
                                        <input type="checkbox" id="showCaptions" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                                
                                <div class="form-group" style="display: flex; justify-content: space-between; align-items: center;">
                                    <span>Activer le filtre par catégorie</span>
                                    <label class="switch">
                                        <input type="checkbox" id="enableFilter" checked>
                                        <span class="slider"></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div style="display: flex; gap: 15px; margin-top: 40px;">
                            <button id="saveSettingsBtn" class="btn btn-primary" style="flex: 1;">
                                <i class="fas fa-save"></i> Enregistrer les Paramètres
                            </button>
                            <button id="resetSettingsBtn" class="btn" style="flex: 1; background: rgba(255, 255, 255, 0.05); color: rgba(255, 255, 255, 0.8);">
                                <i class="fas fa-undo"></i> Réinitialiser
                            </button>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </div>

    <!-- Toast Notifications Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Photo Details Modal -->
    <div class="modal" id="photoModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Détails de la Photo</h3>
                <button class="close-btn" id="closeModalBtn">&times;</button>
            </div>
            <div class="modal-body">
                <div id="modalPhotoContent">
                    <!-- Photo details will be dynamically added here -->
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Photo Modal -->
    <div class="modal" id="editPhotoModal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Modifier la Photo</h3>
                <button class="close-btn" id="closeEditModalBtn">&times;</button>
            </div>
            <div class="modal-body">
                <form id="editPhotoForm">
                    <!-- Edit form will be dynamically added here -->
                </form>
            </div>
        </div>
    </div>

    <script>
        // ============================================
        // EMPTY GALLERY DATA MANAGEMENT
        // ============================================

        // Initialize EMPTY gallery data
        let galleryData = JSON.parse(localStorage.getItem('kribiParadiseGallery')) || [];

        // Initialize with default categories only
        let categories = JSON.parse(localStorage.getItem('kribiParadiseCategories')) || [
            { id: 1, name: "Plages", slug: "beaches", color: "#D4AF37", count: 0 },
            { id: 2, name: "Hébergements", slug: "accommodation", color: "#27ae60", count: 0 },
            { id: 3, name: "Activités", slug: "activities", color: "#3498db", count: 0 },
            { id: 4, name: "Tourisme", slug: "tourism", color: "#9b59b6", count: 0 },
            { id: 5, name: "Nature", slug: "nature", color: "#2ecc71", count: 0 }
        ];

        // Initialize settings
        let settings = JSON.parse(localStorage.getItem('kribiParadiseSettings')) || {
            galleryTitle: "Galerie Kribi Paradise",
            galleryDescription: "Découvrez la beauté captivante de Kribi à travers notre collection exclusive de photos.",
            galleryStyle: "masonry",
            itemsPerPage: 24,
            showCaptions: true,
            enableFilter: true,
            lastBackup: null
        };

        // ============================================
        // DOM ELEMENTS
        // ============================================

        // Navigation
        const sidebar = document.querySelector('.sidebar');
        const mainContent = document.getElementById('mainContent');
        const toggleSidebarBtn = document.getElementById('toggleSidebar');
        const sidebarLinks = document.querySelectorAll('.sidebar-menu a');
        const contentSections = document.querySelectorAll('.content-section');
        const pageTitle = document.getElementById('pageTitle');

        // Dashboard
        const totalPhotosElement = document.getElementById('totalPhotos');
        const totalCategoriesElement = document.getElementById('totalCategories');
        const lastUpdateElement = document.getElementById('lastUpdate');
        const publishedPhotosElement = document.getElementById('publishedPhotos');
        const recentPhotosGrid = document.getElementById('recentPhotosGrid');
        const viewAllBtn = document.getElementById('viewAllBtn');
        const refreshBtn = document.getElementById('refreshBtn');
        const addFirstPhotoBtn = document.getElementById('addFirstPhotoBtn');

        // Gallery Management
        const galleryGrid = document.getElementById('galleryGrid');
        const addNewPhotoBtn = document.getElementById('addNewPhotoBtn');
        const addFirstGalleryPhotoBtn = document.getElementById('addFirstGalleryPhotoBtn');
        const filterAllBtn = document.getElementById('filterAll');

        // Add Photo Form
        const photoForm = document.getElementById('photoForm');
        const photoCategorySelect = document.getElementById('photoCategory');
        const fileUpload = document.getElementById('photoUpload');
        const fileInput = document.getElementById('fileInput');
        const fileName = document.getElementById('fileName');
        const imagePreview = document.getElementById('imagePreview');
        const previewImage = document.getElementById('previewImage');
        const categoryTagsContainer = document.getElementById('categoryTags');
        const saveDraftBtn = document.getElementById('saveDraftBtn');

        // Categories Management
        const newCategoryName = document.getElementById('newCategoryName');
        const addCategoryBtn = document.getElementById('addCategoryBtn');
        const categoriesList = document.getElementById('categoriesList');

        // Preview Gallery
        const previewGallery = document.getElementById('previewGallery');
        const refreshPreviewBtn = document.getElementById('refreshPreviewBtn');

        // Settings
        const saveSettingsBtn = document.getElementById('saveSettingsBtn');
        const resetSettingsBtn = document.getElementById('resetSettingsBtn');

        // Modals
        const photoModal = document.getElementById('photoModal');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const modalPhotoContent = document.getElementById('modalPhotoContent');
        const editPhotoModal = document.getElementById('editPhotoModal');
        const closeEditModalBtn = document.getElementById('closeEditModalBtn');
        const editPhotoForm = document.getElementById('editPhotoForm');

        // Toast Container
        const toastContainer = document.getElementById('toastContainer');

        // ============================================
        // UTILITY FUNCTIONS
        // ============================================

        // Save data to localStorage
        function saveData() {
            localStorage.setItem('kribiParadiseGallery', JSON.stringify(galleryData));
            localStorage.setItem('kribiParadiseCategories', JSON.stringify(categories));
            localStorage.setItem('kribiParadiseSettings', JSON.stringify(settings));
            
            // Also save to galleryData for the gallery page
            localStorage.setItem('galleryData', JSON.stringify(galleryData.filter(photo => photo.status === 'published')));
        }

        // Show toast notification
        function showToast(message, type = 'info') {
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            toast.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'}"></i>
                <span>${message}</span>
            `;
            toastContainer.appendChild(toast);
            
            setTimeout(() => {
                if (toast.parentNode) {
                    toast.remove();
                }
            }, 5000);
        }

        // Format date
        function formatDate(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('fr-FR', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
        }

        // Generate unique ID
        function generateId() {
            return Date.now().toString(36) + Math.random().toString(36).substr(2);
        }

        // Calculate days since last update
        function getDaysSinceLastUpdate() {
            if (galleryData.length === 0) return 0;
            
            const latestPhoto = galleryData.reduce((latest, photo) => {
                return new Date(photo.createdAt) > new Date(latest.createdAt) ? photo : latest;
            }, galleryData[0]);
            
            const lastUpdate = new Date(latestPhoto.createdAt);
            const today = new Date();
            const diffTime = Math.abs(today - lastUpdate);
            return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        }

        // ============================================
        // INITIALIZATION
        // ============================================

        function initApp() {
            loadCategories();
            updateDashboardStats();
            renderRecentPhotos();
            renderGallery();
            renderCategories();
            loadSettings();
            setupEventListeners();
            
            showToast('Panel Admin Kribi Paradise chargé avec succès', 'success');
        }

        function updateDashboardStats() {
            // Update photo count
            totalPhotosElement.textContent = galleryData.length;
            
            // Update category count
            totalCategoriesElement.textContent = categories.length;
            
            // Update last update
            const daysSinceUpdate = getDaysSinceLastUpdate();
            lastUpdateElement.textContent = daysSinceUpdate;
            
            // Update published photos count
            const publishedPhotos = galleryData.filter(photo => photo.status === 'published').length;
            publishedPhotosElement.textContent = publishedPhotos;
        }

        function loadCategories() {
            // Clear existing options
            photoCategorySelect.innerHTML = '<option value="">Sélectionnez une catégorie</option>';
            
            // Add category options
            categories.forEach(category => {
                const option = document.createElement('option');
                option.value = category.slug;
                option.textContent = category.name;
                photoCategorySelect.appendChild(option);
            });
            
            // Update category tags
            renderCategoryTags();
        }

        function renderCategoryTags() {
            categoryTagsContainer.innerHTML = '';
            categories.forEach(category => {
                const tag = document.createElement('div');
                tag.className = 'category-tag';
                tag.innerHTML = `
                    <i class="fas fa-tag"></i>
                    <span>${category.name}</span>
                `;
                tag.dataset.slug = category.slug;
                
                tag.addEventListener('click', () => {
                    tag.classList.toggle('active');
                });
                
                categoryTagsContainer.appendChild(tag);
            });
        }

        function renderCategories() {
            categoriesList.innerHTML = '';
            
            if (categories.length === 0) {
                categoriesList.innerHTML = '<p style="color: rgba(255, 255, 255, 0.6); text-align: center;">Aucune catégorie créée</p>';
                return;
            }
            
            categories.forEach(category => {
                const categoryItem = document.createElement('div');
                categoryItem.className = 'category-item';
                categoryItem.style.borderLeftColor = category.color;
                
                categoryItem.innerHTML = `
                    <div class="category-info">
                        <h4 style="color: #FFFFFF; margin-bottom: 5px;">${category.name}</h4>
                        <div class="category-count" style="font-size: 0.8rem; color: rgba(255, 255, 255, 0.5);">
                            ${category.count} photo(s) • ${category.slug}
                        </div>
                    </div>
                    <div class="category-actions">
                        <button class="edit-category-btn" data-id="${category.id}" style="background: none; border: none; color: #D4AF37; cursor: pointer; width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; transition: var(--transition);">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="delete-category-btn" data-id="${category.id}" style="background: none; border: none; color: #e74c3c; cursor: pointer; width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; transition: var(--transition);">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                `;
                
                categoriesList.appendChild(categoryItem);
            });
            
            // Add event listeners to category buttons
            document.querySelectorAll('.edit-category-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const categoryId = parseInt(e.currentTarget.dataset.id);
                    editCategory(categoryId);
                });
            });
            
            document.querySelectorAll('.delete-category-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const categoryId = parseInt(e.currentTarget.dataset.id);
                    deleteCategory(categoryId);
                });
            });
        }

        function renderRecentPhotos() {
            recentPhotosGrid.innerHTML = '';
            
            // Get recent published photos (last 4)
            const recentPhotos = galleryData
                .filter(photo => photo.status === 'published')
                .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt))
                .slice(0, 4);
            
            if (recentPhotos.length === 0) {
                recentPhotosGrid.innerHTML = `
                    <div class="empty-state" style="grid-column: 1 / -1;">
                        <i class="fas fa-images"></i>
                        <h3>Aucune photo dans la galerie</h3>
                        <p>Commencez par ajouter votre première photo pour enrichir votre galerie</p>
                        <button class="btn btn-primary" id="addFirstPhotoBtn">
                            <i class="fas fa-plus"></i> Ajouter une Photo
                        </button>
                    </div>
                `;
                
                document.getElementById('addFirstPhotoBtn')?.addEventListener('click', () => {
                    navigateToSection('add-photo');
                });
                return;
            }
            
            recentPhotos.forEach(photo => {
                const photoCard = createPhotoCard(photo, false);
                recentPhotosGrid.appendChild(photoCard);
            });
        }

        function renderGallery() {
            galleryGrid.innerHTML = '';
            
            if (galleryData.length === 0) {
                galleryGrid.innerHTML = `
                    <div class="empty-state" style="grid-column: 1 / -1;">
                        <i class="fas fa-images"></i>
                        <h3>Galerie Vide</h3>
                        <p>Votre galerie ne contient aucune photo pour le moment</p>
                        <button class="btn btn-primary" id="addFirstGalleryPhotoBtn">
                            <i class="fas fa-plus"></i> Ajouter votre Première Photo
                        </button>
                    </div>
                `;
                
                document.getElementById('addFirstGalleryPhotoBtn')?.addEventListener('click', () => {
                    navigateToSection('add-photo');
                });
                return;
            }
            
            galleryData.forEach(photo => {
                const photoCard = createPhotoCard(photo, true);
                galleryGrid.appendChild(photoCard);
            });
        }

        function renderPreviewGallery() {
            previewGallery.innerHTML = '';
            
            const publishedPhotos = galleryData.filter(photo => photo.status === 'published');
            
            if (publishedPhotos.length === 0) {
                previewGallery.innerHTML = `
                    <div class="empty-state" style="grid-column: 1 / -1;">
                        <i class="fas fa-eye"></i>
                        <h3>Aucune photo publiée</h3>
                        <p>Les photos ajoutées apparaîtront ici une fois publiées</p>
                    </div>
                `;
                return;
            }
            
            // Show all published photos in preview
            publishedPhotos.forEach(photo => {
                const previewCard = createPhotoCard(photo, false);
                previewGallery.appendChild(previewCard);
            });
        }

        function createPhotoCard(photo, withActions = false) {
            const card = document.createElement('div');
            card.className = 'photo-card';
            card.dataset.id = photo.id;
            
            // Status badge
            const statusBadge = photo.status === 'draft' ? '<div class="photo-badge" style="background: #f39c12;">Brouillon</div>' : '';
            
            let actionsHTML = '';
            if (withActions) {
                actionsHTML = `
                    <div class="photo-actions">
                        <button class="btn btn-sm btn-primary view-btn" data-id="${photo.id}">
                            <i class="fas fa-eye"></i> Voir
                        </button>
                        <button class="btn btn-sm btn-warning edit-btn" data-id="${photo.id}">
                            <i class="fas fa-edit"></i> Modifier
                        </button>
                        <button class="btn btn-sm btn-danger delete-btn" data-id="${photo.id}">
                            <i class="fas fa-trash"></i> Supprimer
                        </button>
                        ${photo.status === 'draft' ? 
                            `<button class="btn btn-sm btn-success publish-btn" data-id="${photo.id}">
                                <i class="fas fa-check"></i> Publier
                            </button>` : ''
                        }
                    </div>
                `;
            }
            
            card.innerHTML = `
                <div class="photo-img-container">
                    <img src="${photo.image}" alt="${photo.title}" class="photo-img">
                    ${statusBadge}
                    ${photo.featured ? '<div class="photo-badge" style="background: #D4AF37; left: 12px; right: auto;"><i class="fas fa-star"></i> À la une</div>' : ''}
                </div>
                <div class="photo-info">
                    <div class="photo-title">${photo.title}</div>
                    <div class="photo-category">${photo.categories.map(cat => getCategoryName(cat)).join(', ')}</div>
                    <div class="photo-description">${photo.description}</div>
                    <div class="photo-meta">
                        <span><i class="fas fa-calendar"></i> ${formatDate(photo.date)}</span>
                        <span><i class="fas fa-map-marker-alt"></i> ${photo.location}</span>
                    </div>
                    ${actionsHTML}
                </div>
            `;
            
            // Add event listeners for action buttons
            if (withActions) {
                const viewBtn = card.querySelector('.view-btn');
                const editBtn = card.querySelector('.edit-btn');
                const deleteBtn = card.querySelector('.delete-btn');
                const publishBtn = card.querySelector('.publish-btn');
                
                viewBtn?.addEventListener('click', () => showPhotoDetails(photo.id));
                editBtn?.addEventListener('click', () => editPhoto(photo.id));
                deleteBtn?.addEventListener('click', () => deletePhoto(photo.id));
                publishBtn?.addEventListener('click', () => publishPhoto(photo.id));
            }
            
            return card;
        }

        function getCategoryName(slug) {
            const category = categories.find(cat => cat.slug === slug);
            return category ? category.name : slug;
        }

        function loadSettings() {
            // Load settings into form
            document.getElementById('galleryTitle').value = settings.galleryTitle;
            document.getElementById('galleryDescription').value = settings.galleryDescription;
            document.getElementById('galleryStyle').value = settings.galleryStyle;
            document.getElementById('itemsPerPage').value = settings.itemsPerPage;
            document.getElementById('showCaptions').checked = settings.showCaptions;
            document.getElementById('enableFilter').checked = settings.enableFilter;
        }

        // ============================================
        // EVENT LISTENERS SETUP
        // ============================================

        function setupEventListeners() {
            // Sidebar toggle
            toggleSidebarBtn.addEventListener('click', toggleSidebar);
            
            // Sidebar navigation
            sidebarLinks.forEach(link => {
                if (!link.href.includes('gallery.html')) {
                    link.addEventListener('click', function(e) {
                        e.preventDefault();
                        const sectionId = this.getAttribute('data-section');
                        navigateToSection(sectionId);
                        
                        // Update active state
                        sidebarLinks.forEach(l => l.classList.remove('active'));
                        this.classList.add('active');
                    });
                }
            });
            
            // File upload
            fileUpload.addEventListener('click', () => fileInput.click());
            fileInput.addEventListener('change', handleFileSelect);
            
            // Drag and drop for file upload
            fileUpload.addEventListener('dragover', (e) => {
                e.preventDefault();
                fileUpload.classList.add('dragover');
            });
            
            fileUpload.addEventListener('dragleave', () => {
                fileUpload.classList.remove('dragover');
            });
            
            fileUpload.addEventListener('drop', (e) => {
                e.preventDefault();
                fileUpload.classList.remove('dragover');
                
                if (e.dataTransfer.files.length) {
                    fileInput.files = e.dataTransfer.files;
                    handleFileSelect({ target: fileInput });
                }
            });
            
            // Form submission
            photoForm.addEventListener('submit', handleFormSubmit);
            
            // Save draft button
            saveDraftBtn.addEventListener('click', () => {
                if (validatePhotoForm()) {
                    savePhoto('draft');
                }
            });
            
            // Add category button
            addCategoryBtn.addEventListener('click', addCategory);
            
            // Modal close buttons
            closeModalBtn.addEventListener('click', () => {
                photoModal.classList.remove('active');
            });
            
            closeEditModalBtn.addEventListener('click', () => {
                editPhotoModal.classList.remove('active');
            });
            
            // Close modals when clicking outside
            window.addEventListener('click', (e) => {
                if (e.target === photoModal) {
                    photoModal.classList.remove('active');
                }
                if (e.target === editPhotoModal) {
                    editPhotoModal.classList.remove('active');
                }
            });
            
            // Buttons
            viewAllBtn.addEventListener('click', () => navigateToSection('gallery'));
            addNewPhotoBtn.addEventListener('click', () => navigateToSection('add-photo'));
            refreshPreviewBtn.addEventListener('click', () => {
                renderPreviewGallery();
                showToast('Aperçu actualisé', 'success');
            });
            
            refreshBtn.addEventListener('click', () => {
                updateDashboardStats();
                renderRecentPhotos();
                showToast('Données actualisées', 'success');
            });
            
            // Settings
            saveSettingsBtn.addEventListener('click', saveSettings);
            resetSettingsBtn.addEventListener('click', resetSettings);
            
            // Reset form
            photoForm.addEventListener('reset', () => {
                fileName.textContent = '';
                imagePreview.style.display = 'none';
                categoryTagsContainer.querySelectorAll('.category-tag').forEach(tag => {
                    tag.classList.remove('active');
                });
            });
            
            // Filter all button
            filterAllBtn.addEventListener('click', () => {
                showToast('Toutes les photos affichées', 'info');
            });
        }

        function toggleSidebar() {
            sidebar.classList.toggle('collapsed');
            mainContent.classList.toggle('expanded');
        }

        function navigateToSection(sectionId) {
            // Hide all sections
            contentSections.forEach(section => {
                section.classList.remove('active');
            });
            
            // Show selected section
            document.getElementById(sectionId).classList.add('active');
            
            // Update page title
            const titles = {
                'dashboard': 'Tableau de Bord',
                'gallery': 'Gestion Galerie',
                'add-photo': 'Ajouter Photo',
                'categories': 'Catégories',
                'preview': 'Aperçu Galerie',
                'settings': 'Paramètres'
            };
            pageTitle.textContent = titles[sectionId];
            
            // Refresh specific sections when navigated to
            if (sectionId === 'preview') {
                renderPreviewGallery();
            } else if (sectionId === 'categories') {
                renderCategories();
            } else if (sectionId === 'gallery') {
                renderGallery();
            }
        }

        function handleFileSelect(e) {
            const file = e.target.files[0];
            if (file) {
                // Validate file type
                const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                if (!validTypes.includes(file.type)) {
                    showToast('Type de fichier non supporté. Utilisez JPG, PNG ou GIF.', 'error');
                    return;
                }
                
                // Validate file size (10MB max)
                if (file.size > 10 * 1024 * 1024) {
                    showToast('Fichier trop volumineux. Maximum 10MB.', 'error');
                    return;
                }
                
                fileName.textContent = `Sélectionné: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;
                
                // Show preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                    imagePreview.style.display = 'block';
                };
                reader.readAsDataURL(file);
                
                showToast('Image chargée avec succès', 'success');
            }
        }

        function validatePhotoForm() {
            const title = document.getElementById('photoTitle').value.trim();
            const category = document.getElementById('photoCategory').value;
            const description = document.getElementById('photoDescription').value.trim();
            
            if (!title) {
                showToast('Veuillez entrer un titre pour la photo', 'error');
                return false;
            }
            
            if (!category) {
                showToast('Veuillez sélectionner une catégorie', 'error');
                return false;
            }
            
            if (!description) {
                showToast('Veuillez entrer une description', 'error');
                return false;
            }
            
            if (!fileInput.files[0]) {
                showToast('Veuillez sélectionner une image', 'error');
                return false;
            }
            
            return true;
        }

        function handleFormSubmit(e) {
            e.preventDefault();
            
            if (validatePhotoForm()) {
                savePhoto('published');
            }
        }

        function savePhoto(status) {
            // Get form values
            const title = document.getElementById('photoTitle').value.trim();
            const category = document.getElementById('photoCategory').value;
            const location = document.getElementById('photoLocation').value.trim();
            const description = document.getElementById('photoDescription').value.trim();
            const photographer = document.getElementById('photographer').value.trim();
            const date = document.getElementById('photoDate').value || new Date().toISOString().split('T')[0];
            
            // Get selected tags
            const selectedTags = Array.from(categoryTagsContainer.querySelectorAll('.category-tag.active'))
                .map(tag => tag.dataset.slug);
            
            // For demo purposes, we'll use a placeholder image URL
            // In a real app, you would upload the image to a server
            const imageUrl = "https://images.unsplash.com/photo-1544551763-46a013bb70d5?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80";
            
            // Create new photo object
            const newPhoto = {
                id: generateId(),
                title: title,
                description: description,
                image: imageUrl,
                location: location || "Kribi, Cameroun",
                categories: [category, ...selectedTags],
                date: date,
                photographer: photographer || "Kribi Paradise Team",
                featured: false,
                tags: selectedTags,
                status: status,
                createdAt: new Date().toISOString()
            };
            
            // Add to gallery data
            galleryData.push(newPhoto);
            
            // Update category counts
            updateCategoryCounts();
            
            // Save data to localStorage (for both admin and gallery page)
            saveData();
            
            // Update UI
            updateDashboardStats();
            renderRecentPhotos();
            renderGallery();
            renderPreviewGallery();
            renderCategories();
            
            // Reset form
            photoForm.reset();
            fileName.textContent = '';
            imagePreview.style.display = 'none';
            categoryTagsContainer.querySelectorAll('.category-tag').forEach(tag => {
                tag.classList.remove('active');
            });
            
            // Show success message
            const message = status === 'published' ? 
                `Photo "${title}" publiée avec succès!` : 
                `Photo "${title}" enregistrée comme brouillon.`;
            showToast(message, 'success');
            
            // Navigate to gallery
            navigateToSection('gallery');
        }

        function updateCategoryCounts() {
            // Reset all counts
            categories.forEach(category => {
                category.count = 0;
            });
            
            // Count photos in each category
            galleryData.forEach(photo => {
                photo.categories.forEach(catSlug => {
                    const category = categories.find(c => c.slug === catSlug);
                    if (category) {
                        category.count++;
                    }
                });
            });
        }

        function addCategory() {
            const name = newCategoryName.value.trim();
            
            if (!name) {
                showToast('Veuillez entrer un nom pour la catégorie', 'error');
                return;
            }
            
            // Check if category already exists
            if (categories.some(cat => cat.name.toLowerCase() === name.toLowerCase())) {
                showToast('Cette catégorie existe déjà', 'error');
                return;
            }
            
            // Create slug from name
            const slug = name.toLowerCase()
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9]+/g, '-')
                .replace(/(^-|-$)/g, '');
            
            // Generate a random color
            const colors = ['#D4AF37', '#27ae60', '#3498db', '#9b59b6', '#e74c3c', '#f39c12', '#1abc9c', '#34495e'];
            const color = colors[Math.floor(Math.random() * colors.length)];
            
            // Add new category
            const newCategory = {
                id: categories.length + 1,
                name: name,
                slug: slug,
                color: color,
                count: 0
            };
            
            categories.push(newCategory);
            
            // Save data
            saveData();
            
            // Update UI
            loadCategories();
            renderCategories();
            
            // Clear input
            newCategoryName.value = '';
            
            showToast(`Catégorie "${name}" ajoutée avec succès`, 'success');
        }

        function editCategory(categoryId) {
            const category = categories.find(cat => cat.id === categoryId);
            if (!category) return;
            
            const newName = prompt('Entrez le nouveau nom de la catégorie:', category.name);
            if (newName && newName.trim()) {
                category.name = newName.trim();
                saveData();
                loadCategories();
                renderCategories();
                showToast('Catégorie modifiée avec succès', 'success');
            }
        }

        function deleteCategory(categoryId) {
            const category = categories.find(cat => cat.id === categoryId);
            if (!category) return;
            
            // Check if category has photos
            if (category.count > 0) {
                if (!confirm(`Cette catégorie contient ${category.count} photo(s). Voulez-vous vraiment la supprimer ?`)) {
                    return;
                }
            }
            
            // Remove category
            const index = categories.findIndex(cat => cat.id === categoryId);
            categories.splice(index, 1);
            
            // Remove category from photos
            galleryData.forEach(photo => {
                photo.categories = photo.categories.filter(cat => cat !== category.slug);
            });
            
            saveData();
            loadCategories();
            renderCategories();
            renderGallery();
            renderRecentPhotos();
            renderPreviewGallery();
            
            showToast('Catégorie supprimée avec succès', 'success');
        }

        function showPhotoDetails(photoId) {
            const photo = galleryData.find(p => p.id === photoId);
            if (!photo) return;
            
            modalPhotoContent.innerHTML = `
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">
                    <div>
                        <img src="${photo.image}" alt="${photo.title}" style="width: 100%; border-radius: 12px; box-shadow: var(--shadow);">
                    </div>
                    <div>
                        <h3 style="margin-bottom: 15px; color: #FFFFFF;">${photo.title}</h3>
                        <div style="margin-bottom: 20px;">
                            ${photo.categories.map(cat => `
                                <span style="background: rgba(212, 175, 55, 0.1); color: #D4AF37; padding: 6px 12px; border-radius: 20px; font-size: 0.85rem; margin-right: 8px; display: inline-block; margin-bottom: 8px;">
                                    ${getCategoryName(cat)}
                                </span>
                            `).join('')}
                        </div>
                        <p style="margin-bottom: 15px; color: rgba(255, 255, 255, 0.8);"><strong>Lieu:</strong> ${photo.location}</p>
                        <p style="margin-bottom: 15px; color: rgba(255, 255, 255, 0.8);"><strong>Description:</strong> ${photo.description}</p>
                        <p style="margin-bottom: 15px; color: rgba(255, 255, 255, 0.8);"><strong>Photographe:</strong> ${photo.photographer}</p>
                        <p style="margin-bottom: 15px; color: rgba(255, 255, 255, 0.8);"><strong>Date:</strong> ${formatDate(photo.date)}</p>
                        <p style="margin-bottom: 15px; color: rgba(255, 255, 255, 0.8);"><strong>Statut:</strong> ${photo.status === 'published' ? 'Publié' : 'Brouillon'}</p>
                        <p style="margin-bottom: 15px; color: rgba(255, 255, 255, 0.8);"><strong>Ajouté le:</strong> ${formatDate(photo.createdAt)}</p>
                        <div style="margin-top: 30px; display: flex; gap: 10px;">
                            <button class="btn btn-warning" id="editFromModalBtn" data-id="${photo.id}">
                                <i class="fas fa-edit"></i> Modifier
                            </button>
                            <button class="btn btn-danger" id="deleteFromModalBtn" data-id="${photo.id}">
                                <i class="fas fa-trash"></i> Supprimer
                            </button>
                            ${photo.status === 'draft' ? 
                                `<button class="btn btn-success" id="publishFromModalBtn" data-id="${photo.id}">
                                    <i class="fas fa-check"></i> Publier
                                </button>` : ''
                            }
                        </div>
                    </div>
                </div>
            `;
            
            // Add event listeners to modal buttons
            document.getElementById('editFromModalBtn').addEventListener('click', () => {
                editPhoto(photoId);
                photoModal.classList.remove('active');
            });
            
            document.getElementById('deleteFromModalBtn').addEventListener('click', () => {
                if (confirm('Êtes-vous sûr de vouloir supprimer cette photo ?')) {
                    deletePhoto(photoId);
                    photoModal.classList.remove('active');
                }
            });
            
            if (photo.status === 'draft') {
                document.getElementById('publishFromModalBtn').addEventListener('click', () => {
                    publishPhoto(photoId);
                    photoModal.classList.remove('active');
                });
            }
            
            // Show modal
            photoModal.classList.add('active');
        }

        function editPhoto(photoId) {
            const photo = galleryData.find(p => p.id === photoId);
            if (!photo) return;
            
            editPhotoForm.innerHTML = `
                <div class="form-group">
                    <label for="editPhotoTitle">Titre de la Photo *</label>
                    <input type="text" id="editPhotoTitle" class="form-control" value="${photo.title}" required>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="editPhotoCategory">Catégorie *</label>
                        <select id="editPhotoCategory" class="form-control" required>
                            <option value="">Sélectionnez une catégorie</option>
                            ${categories.map(cat => `
                                <option value="${cat.slug}" ${photo.categories.includes(cat.slug) ? 'selected' : ''}>${cat.name}</option>
                            `).join('')}
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="editPhotoLocation">Lieu</label>
                        <input type="text" id="editPhotoLocation" class="form-control" value="${photo.location}">
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="editPhotoDescription">Description *</label>
                    <textarea id="editPhotoDescription" class="form-control" required>${photo.description}</textarea>
                </div>
                
                <div class="form-row">
                    <div class="form-group">
                        <label for="editPhotographer">Photographe</label>
                        <input type="text" id="editPhotographer" class="form-control" value="${photo.photographer}">
                    </div>
                    <div class="form-group">
                        <label for="editPhotoDate">Date de la Photo</label>
                        <input type="date" id="editPhotoDate" class="form-control" value="${photo.date}">
                    </div>
                </div>
                
                <div class="form-group">
                    <label>À la une</label>
                    <div style="margin-top: 10px;">
                        <label class="switch">
                            <input type="checkbox" id="editFeatured" ${photo.featured ? 'checked' : ''}>
                            <span class="slider"></span>
                        </label>
                        <span style="margin-left: 10px; color: rgba(255, 255, 255, 0.8);">Mettre en avant cette photo</span>
                    </div>
                </div>
                
                <div class="form-group">
                    <label>Statut</label>
                    <div style="margin-top: 10px;">
                        <select id="editPhotoStatus" class="form-control">
                            <option value="published" ${photo.status === 'published' ? 'selected' : ''}>Publié</option>
                            <option value="draft" ${photo.status === 'draft' ? 'selected' : ''}>Brouillon</option>
                        </select>
                    </div>
                </div>
                
                <div style="display: flex; gap: 15px; margin-top: 30px;">
                    <button type="submit" class="btn btn-primary" style="flex: 1;">
                        <i class="fas fa-save"></i> Enregistrer les Modifications
                    </button>
                    <button type="button" id="cancelEditBtn" class="btn" style="flex: 1; background: rgba(255, 255, 255, 0.05); color: rgba(255, 255, 255, 0.8);">
                        <i class="fas fa-times"></i> Annuler
                    </button>
                </div>
            `;
            
            // Handle form submission
            editPhotoForm.onsubmit = (e) => {
                e.preventDefault();
                
                // Update photo
                photo.title = document.getElementById('editPhotoTitle').value.trim();
                photo.description = document.getElementById('editPhotoDescription').value.trim();
                photo.location = document.getElementById('editPhotoLocation').value.trim();
                photo.photographer = document.getElementById('editPhotographer').value.trim();
                photo.date = document.getElementById('editPhotoDate').value;
                photo.featured = document.getElementById('editFeatured').checked;
                photo.status = document.getElementById('editPhotoStatus').value;
                
                // Update category
                const newCategory = document.getElementById('editPhotoCategory').value;
                if (newCategory && !photo.categories.includes(newCategory)) {
                    photo.categories = [newCategory];
                }
                
                // Update category counts
                updateCategoryCounts();
                
                // Save data
                saveData();
                
                // Update UI
                updateDashboardStats();
                renderRecentPhotos();
                renderGallery();
                renderPreviewGallery();
                renderCategories();
                
                // Close modal
                editPhotoModal.classList.remove('active');
                
                showToast('Photo modifiée avec succès', 'success');
            };
            
            // Cancel button
            document.getElementById('cancelEditBtn').addEventListener('click', () => {
                editPhotoModal.classList.remove('active');
            });
            
            // Show modal
            editPhotoModal.classList.add('active');
        }

        function deletePhoto(photoId) {
            const index = galleryData.findIndex(p => p.id === photoId);
            if (index !== -1) {
                galleryData.splice(index, 1);
                
                // Update category counts
                updateCategoryCounts();
                
                // Save data
                saveData();
                
                // Update UI
                updateDashboardStats();
                renderRecentPhotos();
                renderGallery();
                renderPreviewGallery();
                renderCategories();
                
                showToast('Photo supprimée avec succès', 'success');
            }
        }

        function publishPhoto(photoId) {
            const photo = galleryData.find(p => p.id === photoId);
            if (photo) {
                photo.status = 'published';
                saveData();
                updateDashboardStats();
                renderRecentPhotos();
                renderGallery();
                renderPreviewGallery();
                showToast('Photo publiée avec succès', 'success');
            }
        }

        function saveSettings() {
            // Get settings from form
            settings.galleryTitle = document.getElementById('galleryTitle').value;
            settings.galleryDescription = document.getElementById('galleryDescription').value;
            settings.galleryStyle = document.getElementById('galleryStyle').value;
            settings.itemsPerPage = document.getElementById('itemsPerPage').value;
            settings.showCaptions = document.getElementById('showCaptions').checked;
            settings.enableFilter = document.getElementById('enableFilter').checked;
            
            // Save to localStorage
            localStorage.setItem('kribiParadiseSettings', JSON.stringify(settings));
            
            showToast('Paramètres enregistrés avec succès', 'success');
        }

        function resetSettings() {
            if (confirm('Êtes-vous sûr de vouloir réinitialiser tous les paramètres ?')) {
                // Reset to defaults
                settings = {
                    galleryTitle: "Galerie Kribi Paradise",
                    galleryDescription: "Découvrez la beauté captivante de Kribi à travers notre collection exclusive de photos.",
                    galleryStyle: "masonry",
                    itemsPerPage: 24,
                    showCaptions: true,
                    enableFilter: true,
                    lastBackup: null
                };
                
                // Update form
                loadSettings();
                
                // Save to localStorage
                localStorage.setItem('kribiParadiseSettings', JSON.stringify(settings));
                
                showToast('Paramètres réinitialisés avec succès', 'success');
            }
        }

        // ============================================
        // INITIALIZE THE APPLICATION
        // ============================================

        document.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
</html>
